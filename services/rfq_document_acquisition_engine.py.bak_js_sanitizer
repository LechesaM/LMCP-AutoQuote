        "attempts": attempts,
        "failures": failures,
        "successes": attempts - failures,
        "average_latency_seconds": round(avg, 4),
        "failure_rate": round(failures / max(attempts, 1), 4),
        "last_latency_seconds": round(float(elapsed or 0.0), 4),
        "updated_at": _now_iso(),
    }
    _write_json_file(PORTAL_LATENCY_FILE, data)


