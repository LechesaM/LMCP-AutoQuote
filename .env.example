# Core
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/autoquote
REDIS_URL=redis://redis:6379/0

# eTenders OCDS API
OCDS_BASE_URL=https://ocds-api.etenders.gov.za/api
POLL_PAGE_SIZE=200
POLL_LOOKBACK_DAYS=3

# Filters (prototype)
SOE_ALLOWLIST=ESKOM,TRANSNET,DENEL,PRASA,SANRAL,SAA,ALEXKOR,SAFCOL,DBSA,IDC,ACSA,SA EXPRESS
DELIVERY_KEYWORDS=supply,delivery,deliver,deliveries,deliverable,dispatch,logistics,transport,warehouse

# Your company signature
YOUR_COMPANY_NAME=Lechesa Manaba Consulting and Projects (Pty) Ltd
YOUR_CONTACT_EMAIL=info@example.com
YOUR_CONTACT_PHONE=+27 00 000 0000
YOUR_LOCATION=South Africa

# Draft style
EMAIL_TONE=professional


# SAFE SENDING (default: off)
SEND_ENABLED=false

# SMTP settings (only used if SEND_ENABLED=true)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_TLS=true
MAIL_FROM=info@example.com

# Safety gates
REQUIRE_RFP_EMAIL_ALLOWED=true
MAX_SENDS_PER_DAY=20
