@celery_app.task(name="app.tasks.health_check")
def health_check() -> Dict[str, Any]:
    return {
        "status": "ok",
        "timestamp": datetime.utcnow().isoformat(),
        "database_url_set": bool(DATABASE_URL),
        "etenders_api_url": ETENDERS_API_URL,
    }


@celery_app.task(name="app.tasks.poll_etenders")
def poll_etenders(date_from: Optional[str] = None, date_to: Optional[str] = None) -> Dict[str, Any]:
    """
    Poll National Treasury OCDS endpoint.

    We DO NOT append '/api/records' anymore.
    Whatever you set as ETENDERS_API_URL will be called directly.
    """
    # Default range: last 7 days
    if not date_to:
        date_to = date.today().isoformat()
    if not date_from:
        date_from = (date.today() - timedelta(days=7)).isoformat()

    params = {"date_from": date_from, "date_to": date_to}

    try:
        resp = requests.get(ETENDERS_API_URL, params=params, timeout=REQUEST_TIMEOUT_SECONDS)
        resp.raise_for_status()
        payload = resp.json()
        items = _extract_records(payload)

        rows = []
        sample_titles = []
        for item in items[:2000]:  # safety cap
            title, buyer, source, published_dt, closing_dt, reference, raw = _extract_opportunity_fields(item)
            rows.append((title, buyer, source, published_dt, closing_dt, reference, raw))
            if len(sample_titles) < 5:
                sample_titles.append(title)

        inserted = _insert_opportunities(rows)

        return {
            "source": "etenders",
            "date_from": date_from,
            "date_to": date_to,
            "fetched_releases": len(items),
            "inserted": inserted,
            "sample_titles": sample_titles,
            "note": f"Called ETENDERS_API_URL directly: {ETENDERS_API_URL}",
        }

    except Exception as e:
        return {
            "source": "etenders",
            "date_from": date_from,
            "date_to": date_to,
            "fetched_releases": 0,
            "inserted": 0,
            "sample_titles": [],
            "error": str(e),
            "note": f"Failed calling {ETENDERS_API_URL} with params {params}",
        }
