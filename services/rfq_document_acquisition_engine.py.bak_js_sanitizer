def _dedupe_dead_letters(items: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
    deduped: List[Dict[str, Any]] = []
    seen = set()
    for item in reversed(items):
        if not isinstance(item, dict):
            continue
        key = (_canonical_url(item.get("url")), _safe_str(item.get("reason") or ""))
        if not key[0] or key in seen:
            continue
        seen.add(key)
        deduped.append(item)
    return list(reversed(deduped))


def _dead_letter_summary() -> Dict[str, Any]:
    items = _load_dead_letters()
    by_source = {}
    by_reason = {}
    for item in items:
        if not isinstance(item, dict):
            continue
        source = _safe_str(item.get("source") or "unknown")
        reason = _safe_str(item.get("reason") or "unknown")
        by_source[source] = int(by_source.get(source, 0)) + 1
        by_reason[reason] = int(by_reason.get(reason, 0)) + 1
    return {
        "dead_letter_count": len(items),
        "dead_letter_by_source": sorted(
            [{"source": k, "count": v} for k, v in by_source.items()],
            key=lambda row: row["count"],
            reverse=True,
        )[:10],
        "dead_letter_by_reason": sorted(
            [{"reason": k, "count": v} for k, v in by_reason.items()],
            key=lambda row: row["count"],
            reverse=True,
        )[:10],
    }


