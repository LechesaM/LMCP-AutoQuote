def _aspnet_markers(text: str) -> Dict[str, bool]:
    blob = _safe_lower(text)
    return {
        "viewstate": "__viewstate" in blob,
        "eventvalidation": "__eventvalidation" in blob,
        "request_verification_token": "__requestverificationtoken" in blob or "requestverificationtoken" in blob,
        "datatables": "paginatedtenderopportunities" in blob or "datatable" in blob,
        "downloadspec": "downloadspec" in blob,
        "support_document": "supportdocument" in blob,
    }


def _response_debug_details(response: Any, body: bytes = b"") -> Dict[str, Any]:
    text = ""
    try:
        if body:
            text = body[:1200].decode("utf-8", errors="replace")
        else:
            text = (getattr(response, "text", "") or "")[:1200]
    except Exception:
        text = ""
    history = []
    try:
        for item in getattr(response, "history", []) or []:
            history.append({
                "status_code": int(getattr(item, "status_code", 0) or 0),
                "url": str(getattr(item, "url", "") or ""),
                "location": str(getattr(item, "headers", {}).get("location", "") or ""),
            })
    except Exception:
        history = []
    return {
        "status_code": int(getattr(response, "status_code", 0) or 0),
        "content_type": str(getattr(response, "headers", {}).get("content-type", "") or ""),
        "content_disposition": str(getattr(response, "headers", {}).get("content-disposition", "") or ""),
        "final_url": str(getattr(response, "url", "") or ""),
        "redirect_chain": history,
        "short_response_snippet": re.sub(r"\s+", " ", text).strip()[:500],
        "detected_aspnet_markers": _aspnet_markers(text),
    }


def _cache_key(url: str) -> str:
    return hashlib.sha256(_safe_str(url).encode("utf-8")).hexdigest()


def _load_cache_index() -> Dict[str, Any]:
    data = _read_json_file(CACHE_INDEX_FILE, {})
    return data if isinstance(data, dict) else {}


def _save_cache_index(data: Dict[str, Any]) -> None:
    _write_json_file(CACHE_INDEX_FILE, data)


def _cache_hit(url: str) -> Optional[Dict[str, Any]]:
    cache = _load_cache_index()
    row = cache.get(_cache_key(url))
    if not isinstance(row, dict):
        return None
    path = Path(str(row.get("path") or ""))
    if path.exists() and path.is_file():
        return {
            **row,
            "status": "downloaded",
            "cache_hit": True,
            "url": url,
            "download_time_seconds": 0.0,
            "attempts": 0,
        }
    return None


def _record_cache(url: str, result: Dict[str, Any]) -> None:
    if result.get("status") != "downloaded" or not result.get("path"):
        return
    cache = _load_cache_index()
    cache[_cache_key(url)] = {
        "url": url,
        "final_url": result.get("final_url"),
        "path": result.get("path"),
        "filename": result.get("filename"),
        "extension": result.get("extension"),
        "content_type": result.get("content_type"),
        "size_bytes": result.get("size_bytes", 0),
        "cached_at": _now_iso(),
    }
    _save_cache_index(cache)


