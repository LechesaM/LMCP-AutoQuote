# =========================
# ⚙️ SYSTEM FLAGS
# =========================
ENV=development
DEBUG=true

ETENDERS_OCDS_ENABLED=true
ETENDERS_OCDS_BASE_URL=https://ocds-api.etenders.gov.za
ETENDERS_OCDS_RELEASES_ENDPOINT=/api/OCDSReleases
ETENDERS_OCDS_TIMEOUT=30
ETENDERS_OCDS_MAX_PAGES=5
ETENDERS_OCDS_PAGE_SIZE=100
ETENDERS_OCDS_MONTHS_BACK=2
TRANSNET_VERIFY_SSL=false
ETENDERS_OCDS_LOOKBACK_DAYS=30

LMCP_INCLUDE_ONLY_SUPPLY=true
LMCP_EXCLUDE_COMPULSORY_BRIEFING=true
