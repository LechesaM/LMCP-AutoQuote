def replay_dead_letters(
    limit: int = 25,
    timeout_seconds: int = FAILED_CANDIDATE_TIMEOUT_SECONDS,
    max_concurrent_downloads: int = 4,
    retry_backoff_seconds: float = 0.25,
) -> Dict[str, Any]:
    _ensure_dirs()
    started = time.monotonic()
    items = _load_dead_letters()
    newest_unique: List[Dict[str, Any]] = []
    seen = set()
    for item in reversed(items):
        if not isinstance(item, dict):
            continue
        url = _canonical_url(item.get("url"))
        if not _is_http_url(url) or url in seen:
            continue
        seen.add(url)
        newest_unique.append({**item, "url": url})
        if len(newest_unique) >= max(1, int(limit)):
            break

    replayed = 0
    recovered = 0
    repeated_404_skipped = 0
    still_failed = 0
    results: List[Dict[str, Any]] = []
    replay_preflights: List[Dict[str, Any]] = []
    recovered_urls = set()

    def _replay(item: Dict[str, Any]) -> Dict[str, Any]:
        url = _canonical_url(item.get("url"))
        if any(token in url for token in ["<", ">", "\n", "\r", "\t"]) or len(url) > 500:
            return {
                "status": "skipped",
                "url": url,
                "source": _source_key(url),
                "error": "malformed_dead_letter_url",
                "reason": "malformed_dead_letter_url",
            }
        candidate = {
            "url": url,
            "source_page": item.get("source_page") or "https://www.etenders.gov.za/Home/opportunities",
            "link_text": item.get("link_text") or "dead-letter replay",
            "score": 0.45,
            "acquisition_strategy": "dead_letter_replay",
            "bypass_source_cooldown": True,
            "suppress_dead_letter": True,
        }
        if "etenders.gov.za" in _safe_lower(url):
            if _should_skip_repeated_404(url):
                return {
                    "status": "skipped",
                    "url": url,
                    "source": _source_key(url),
                    "error": "repeated_404_signature",
                    "reason": "repeated_404_signature",
                }
            preflight = _preflight_etenders_candidate(candidate, timeout_seconds=min(timeout_seconds, PREFLIGHT_TIMEOUT_SECONDS))
            candidate["etenders_preflight"] = preflight
            replay_preflights.append(preflight)
            if preflight.get("reason") in {"preflight_404", "preflight_bad_redirect", "preflight_file_too_large", "preflight_too_small", "preflight_repeated_404_skipped"}:
                _record_etenders_pattern(url, False, int(preflight.get("status_code") or 0))
                return {
                    "status": "skipped",
                    "url": url,
                    "source": _source_key(url),
                    "error": preflight.get("reason"),
                    "reason": preflight.get("reason"),
                    "preflight": preflight,
                }
        return download_candidate_document(
            candidate,
            title=item.get("link_text") or item.get("source") or "dead letter replay",
            timeout_seconds=max(1, min(int(timeout_seconds), FAILED_CANDIDATE_TIMEOUT_SECONDS)),
            retry_backoff_seconds=retry_backoff_seconds,
            max_retries=0,
        )

    if newest_unique:
        with ThreadPoolExecutor(max_workers=min(max(1, int(max_concurrent_downloads)), len(newest_unique))) as executor:
            future_map = {executor.submit(_replay, item): item for item in newest_unique}
            for future in as_completed(future_map):
                replayed += 1
                try:
                    result = future.result()
                except Exception as exc:
                    result = {"status": "failed", "error": str(exc), "url": future_map[future].get("url")}
                if result.get("status") == "downloaded":
                    recovered += 1
                    recovered_urls.add(_canonical_url(result.get("url")))
                elif result.get("reason") == "repeated_404_signature" or result.get("error") == "repeated_404_signature":
                    repeated_404_skipped += 1
                else:
                    still_failed += 1
                results.append(result)

    remaining = [item for item in items if _canonical_url(item.get("url")) not in recovered_urls]
    _write_dead_letters(_dedupe_dead_letters(remaining))

    _update_replay_metrics(replayed, recovered, repeated_404_skipped, replay_preflights)
    metrics = get_acquisition_metrics()
    return {
        "status": "ok",
        "mode": "dead_letter_replay_no_submission",
        "replayed_count": replayed,
        "recovered_count": recovered,
        "still_failed_count": still_failed,
        "repeated_404_skipped": repeated_404_skipped,
        "remaining_dead_letter_count": _dead_letter_summary().get("dead_letter_count", 0),
        "elapsed_seconds": round(time.monotonic() - started, 4),
        "results": results[:100],
        "metrics": {
            "dead_letters_replayed": int(metrics.get("dead_letters_replayed") or 0),
            "dead_letters_recovered": int(metrics.get("dead_letters_recovered") or 0),
            "repeated_404_skipped": int(metrics.get("repeated_404_skipped") or 0),
            "token_cache_hit_rate": float(metrics.get("token_cache_hit_rate") or 0.0),
            "average_preflight_time": float(metrics.get("average_preflight_time") or 0.0),
        },
        "safety": {
            "no_email_send": True,
            "no_portal_upload": True,
            "no_final_submit": True,
            "captcha_bypass": False,
        },
    }


def debug_etenders_acquisition(url: str, timeout_seconds: int = 15) -> Dict[str, Any]:
    _ensure_dirs()
    url = _normalise_url(url)
    if not _is_http_url(url) or "etenders.gov.za" not in _safe_lower(url):
        return {
            "status": "error",
            "error": "url_must_be_etenders_http_url",
            "url": url,
            "safe_to_process": False,
        }

    item = {
        "title": "eTenders acquisition debug",
        "source_url": url,
        "detail_url": url,
        "document_url": url if _looks_like_downloadable_document(url, "") else "",
    }
    crawl = crawl_rfq_document_links(item, timeout_seconds=max(3, int(timeout_seconds or 15)))
    candidates = crawl.get("discovered_links") if isinstance(crawl.get("discovered_links"), list) else []
    if not candidates and _looks_like_downloadable_document(url, ""):
        fingerprint = _portal_fingerprint(url)
        candidates = [
            _candidate_with_strategy(
                url,
                url,
                "debug supplied URL",
                "debug_etenders_supplied_url",
                fingerprint,
                score_boost=0.2,
                bypass_cooldown=True,
            )
        ]

    chosen = candidates[0] if candidates else {}
    attempt = {}
    if chosen:
        attempt = download_candidate_document(
            chosen,
            "eTenders acquisition debug",
            timeout_seconds=max(3, int(timeout_seconds or 15)),
            retry_backoff_seconds=0.5,
            max_retries=1,
        )

    fingerprint = (
        chosen.get("portal_fingerprint")
        if isinstance(chosen.get("portal_fingerprint"), dict)
        else _portal_fingerprint(url)
    )
    return {
        "status": "ok",
        "mode": "debug_only_no_submission",
        "url": url,
        "portal_fingerprint": fingerprint,
        "candidate_document_urls": [
            {
                "url": candidate.get("url"),
                "score": candidate.get("score"),
                "strategy": candidate.get("acquisition_strategy"),
                "portal_type": candidate.get("portal_type"),
                "source_handler": candidate.get("source_handler"),
                "reasons": candidate.get("reasons") if isinstance(candidate.get("reasons"), list) else [],
            }
            for candidate in candidates[:50]
            if isinstance(candidate, dict) and candidate.get("url")
        ],
        "candidate_count": len(candidates),
        "chosen_url": chosen.get("url") if isinstance(chosen, dict) else "",
        "status_code": int(attempt.get("status_code") or 0) if isinstance(attempt, dict) else 0,
        "final_url": attempt.get("final_url") if isinstance(attempt, dict) else "",
        "content_type": attempt.get("content_type") if isinstance(attempt, dict) else "",
        "failure_reason": attempt.get("error") if isinstance(attempt, dict) and attempt.get("status") != "downloaded" else "",
        "extraction_strategy_used": chosen.get("acquisition_strategy") if isinstance(chosen, dict) else "",
        "download_status": attempt.get("status") if isinstance(attempt, dict) else "not_attempted",
        "etenders_debug": attempt.get("etenders_debug") if isinstance(attempt, dict) and isinstance(attempt.get("etenders_debug"), dict) else {},
        "crawl_summary": {
            "seed_urls": crawl.get("seed_urls", []),
            "discovered_count": crawl.get("discovered_count", 0),
            "portal_fetch_count": crawl.get("portal_fetch_count", 0),
            "strategy_candidate_counts": crawl.get("strategy_candidate_counts", {}),
            "portal_fingerprints": crawl.get("portal_fingerprints", []),
