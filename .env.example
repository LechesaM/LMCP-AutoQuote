LMCP_ENV=development
LMCP_PRODUCTION_MODE=manual_production
LMCP_DEPLOYMENT_PROFILE=local_dev
STRICT_PRODUCTION_STARTUP=true
LMCP_BACKEND_HOST_PORT=8001
LMCP_DEBUG=1
LMCP_ENABLE_LEGACY_ROUTERS=0
LMCP_DB_BACKEND=sqlite
LMCP_DATABASE_URL=
LMCP_POSTGRES_HOST=localhost
LMCP_POSTGRES_PORT=5432
LMCP_POSTGRES_DB=lmcp
LMCP_POSTGRES_USER=lmcp
LMCP_POSTGRES_PASSWORD=
POSTGRES_USER=lmcp
POSTGRES_PASSWORD=
POSTGRES_DB=lmcp
DB_HOST=localhost
DB_DOCKER_HOST=postgres
DB_LOCAL_HOST=localhost
DB_PORT=5432
DATABASE_URL=postgresql://lmcp:lmcp@postgres:5432/lmcp
LMCP_QUEUE_BACKEND=local
LMCP_REDIS_URL=
LMCP_REDIS_HOST=localhost
LMCP_REDIS_PORT=6379
LMCP_REDIS_DB=0
LMCP_AUTH_REQUIRED=1
LMCP_AUTH_ALLOW_DEMO_USERS=1
LMCP_OPERATOR_SESSION_COOKIE_SECURE=0
LMCP_OPERATOR_SESSION_TIMEOUT_SECONDS=28800
LMCP_CORS_ORIGINS=*
LMCP_RATE_LIMIT_ENABLED=0
LMCP_RATE_LIMIT_PER_MINUTE=60
LMCP_TELEMETRY_FALLBACK_ENABLED=1
LMCP_SENTRY_DSN=
LMCP_ENABLE_SENTRY=0
LMCP_PROJECT_ROOT=/app
LMCP_RUNTIME_DIR=/app/runtime
LMCP_MANUAL_PRODUCTION_DIR=/app/runtime/manual_production
LMCP_MANUAL_PRODUCTION_DB_PATH=/app/runtime/manual_production/lmcp_operations.db
LMCP_SECRET_KEY=change-me
