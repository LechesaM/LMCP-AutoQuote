# LMCP staging environment
# Copy this to `.env.staging` and adjust secrets/ports for your local setup.

LMCP_ENV=staging
LMCP_PRODUCTION_MODE=staging
LMCP_DEPLOYMENT_PROFILE=supervised_live
STRICT_PRODUCTION_STARTUP=0
LMCP_ALLOW_DEGRADED_STARTUP=true
LMCP_ALLOW_FINAL_AUTOMATION=false
LMCP_ENABLE_LEGACY_ROUTERS=0
LMCP_OBSERVABILITY_ENABLED=1

POSTGRES_DB=lmcp_staging
POSTGRES_USER=lmcp_staging
POSTGRES_PASSWORD=change-me-staging
LMCP_DATABASE_URL=postgresql://lmcp_staging:change-me-staging@postgres:5432/lmcp_staging
DATABASE_URL=postgresql://lmcp_staging:change-me-staging@postgres:5432/lmcp_staging
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
LMCP_DB_BACKEND=postgres
LMCP_QUEUE_BACKEND=redis

LMCP_PROJECT_ROOT=/app
LMCP_RUNTIME_DIR=/app/runtime/staging
LMCP_MONTHLY_QUOTES_DIR=/app/runtime/staging/monthly_quotes
LMCP_LOG_DIR=/app/runtime/staging/logs
LMCP_HEALTH_DIR=/app/runtime/staging/health
LMCP_EXPORTS_DIR=/app/runtime/staging/exports
LMCP_TEMP_DIR=/app/runtime/staging/tmp
LMCP_BACKUPS_DIR=/app/runtime/staging/backups
LMCP_AUDIT_TRAIL_DIR=/app/runtime/staging/audit_trail
LMCP_SUBMISSION_HISTORY_DIR=/app/runtime/staging/submission_history
LMCP_LOCKS_DIR=/app/runtime/staging/locks
LMCP_SUBMISSION_PROOFS_DIR=/app/runtime/staging/submission_proofs
LMCP_PORTAL_SUBMISSION_DIR=/app/runtime/staging/portal_submission
LMCP_FINAL_SUBMISSION_DIR=/app/runtime/staging/final_submission_v47_5
LMCP_PROOF_CENTER_DIR=/app/runtime/staging/proof_center
LMCP_OPERATOR_AUTH_DIR=/app/runtime/staging/operator_auth
LMCP_OPERATOR_AUTH_DB_PATH=/app/runtime/staging/operator_auth/operator_auth.sqlite3
LMCP_HANDWRITING_RUNTIME_DIR=/app/runtime/staging/handwriting_simulation
LMCP_TENDER_FORM_RUNTIME_DIR=/app/runtime/staging/tender_form_intelligence
LMCP_CLICKABLE_NAVIGATION_RUNTIME_DIR=/app/runtime/staging/clickable_navigation_v40

PORTAL_ISOLATION_ENABLED=true
PORTAL_ISOLATION_STATE_FILE=/app/runtime/staging/portal_isolation_state.json
PORTAL_ISOLATION_FAILURE_THRESHOLD=3
PORTAL_ISOLATION_MINUTES=60

LMCP_BACKEND_HOST_PORT=8012
LMCP_FRONTEND_HOST_PORT=4175
LMCP_POSTGRES_HOST_PORT=5433
LMCP_REDIS_HOST_PORT=6380
LMCP_PROMETHEUS_HOST_PORT=9091
LMCP_GRAFANA_HOST_PORT=3001

LMCP_APP_ENTRYPOINT=app.main:app
LMCP_BACKEND_URL=http://backend:8000
LMCP_FRONTEND_URL=http://127.0.0.1:4175

