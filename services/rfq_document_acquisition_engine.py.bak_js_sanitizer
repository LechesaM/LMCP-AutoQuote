def _source_in_cooldown(source: str) -> bool:
    health = _load_source_health()
    row = health.get(source)
    if not isinstance(row, dict):
        return False
    try:
        until = float(row.get("cooldown_until_epoch") or 0)
        return until > time.time()
    except Exception:
        return False


def _update_source_health(source: str, success: bool, elapsed: float, retry_count: int = 0) -> None:
    health = _load_source_health()
    row = health.get(source) if isinstance(health.get(source), dict) else {}
    attempts = int(row.get("attempts") or 0) + 1
    failures = int(row.get("failures") or 0) + (0 if success else 1)
    successes = int(row.get("successes") or 0) + (1 if success else 0)
    retries = int(row.get("retries") or 0) + int(retry_count)
    avg_time = ((float(row.get("average_download_time") or 0.0) * (attempts - 1)) + float(elapsed or 0.0)) / max(attempts, 1)
    failure_rate = failures / max(attempts, 1)
    cooldown_until = 0.0
    if attempts >= 3 and failure_rate >= 0.75:
        cooldown_until = time.time() + SOURCE_COOLDOWN_SECONDS
    health[source] = {
        "attempts": attempts,
        "successes": successes,
        "failures": failures,
        "retries": retries,
        "failure_rate": round(failure_rate, 4),
        "average_download_time": round(avg_time, 4),
        "cooldown_until_epoch": cooldown_until,
        "cooldown_active": cooldown_until > time.time(),
        "updated_at": _now_iso(),
    }
    _save_source_health(health)


def _source_reliability_rows() -> List[Dict[str, Any]]:
    rows = []
    for source, row in _load_source_health().items():
        if not isinstance(row, dict):
            continue
        attempts = int(row.get("attempts") or 0)
        successes = int(row.get("successes") or 0)
        failures = int(row.get("failures") or 0)
        retries = int(row.get("retries") or 0)
        failure_rate = float(row.get("failure_rate") or 0.0)
        avg_time = float(row.get("average_download_time") or 0.0)
        reliability = 100.0
        reliability -= min(60.0, failure_rate * 60.0)
        reliability -= min(20.0, retries / max(attempts, 1) * 20.0)
        reliability -= min(20.0, max(0.0, avg_time - 2.0) * 2.0)
        rows.append(
            {
                "source": source,
                "attempts": attempts,
                "successes": successes,
                "failures": failures,
                "retries": retries,
                "failure_rate": round(failure_rate, 4),
                "average_download_time": round(avg_time, 4),
                "cooldown_active": bool(row.get("cooldown_active")),
                "reliability_score": round(max(0.0, min(100.0, reliability)), 2),
            }
        )
    return sorted(rows, key=lambda item: item["reliability_score"], reverse=True)


def _record_portal_latency(source: str, elapsed: float, success: bool) -> None:
    data = _read_json_file(PORTAL_LATENCY_FILE, {})
    if not isinstance(data, dict):
        data = {}
    row = data.get(source) if isinstance(data.get(source), dict) else {}
    attempts = int(row.get("attempts") or 0) + 1
    failures = int(row.get("failures") or 0) + (0 if success else 1)
    previous_avg = float(row.get("average_latency_seconds") or 0.0)
