LMCP_ENV=production
LMCP_PRODUCTION_MODE=locked_production
LMCP_DEPLOYMENT_PROFILE=production
STRICT_PRODUCTION_STARTUP=1
LMCP_APP_ENTRYPOINT=app.main:app
LMCP_PROJECT_ROOT=/app
LMCP_RUNTIME_DIR=/app/runtime
LMCP_MANUAL_PRODUCTION_DIR=/app/runtime/manual_production
LMCP_MANUAL_PRODUCTION_DB_PATH=/app/runtime/manual_production/lmcp_operations.db
LMCP_BACKUPS_DIR=/app/runtime/backups
LMCP_HEALTH_DIR=/app/runtime/health
LMCP_LOG_DIR=/app/runtime/logs
LMCP_EXPORTS_DIR=/app/runtime/exports
LMCP_DB_BACKEND=postgres
LMCP_QUEUE_BACKEND=redis
LMCP_DATABASE_URL=postgresql://lmcp:lmcp@postgres:5432/lmcp
LMCP_POSTGRES_HOST=postgres
LMCP_POSTGRES_PORT=5432
LMCP_POSTGRES_DB=lmcp
LMCP_POSTGRES_USER=lmcp
LMCP_POSTGRES_PASSWORD=lmcp
DATABASE_URL=postgresql://lmcp:lmcp@postgres:5432/lmcp
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
LMCP_AUTH_REQUIRED=1
LMCP_AUTH_ALLOW_DEMO_USERS=0
LMCP_ENABLE_LEGACY_ROUTERS=0
LMCP_OPERATOR_SESSION_COOKIE_SECURE=1
LMCP_RATE_LIMIT_ENABLED=1
LMCP_RATE_LIMIT_PER_MINUTE=60
LMCP_CORS_ORIGINS=https://command-centre.lmcp.local
LMCP_SECRET_KEY=replace-with-a-long-random-secret
LMCP_DEBUG=0
LMCP_LOG_LEVEL=INFO
LMCP_OBSERVABILITY_ENABLED=1
LMCP_TELEMETRY_FALLBACK_ENABLED=0
LMCP_ALLOW_DEGRADED_STARTUP=0
LMCP_RUNTIME_SAFETY_ENABLED=1
LMCP_DEPLOYMENT_HARDENING_ENABLED=1
LMCP_ENABLE_SENTRY=0
LMCP_SENTRY_DSN=
SUBMISSION_RETRY_SCHEDULE_MINUTES=15
SUPPLIER_QUOTE_AUTO_INGESTION_SCHEDULE_MINUTES=15
SUPPLIER_QUOTE_AUTOMATION_SCHEDULE_MINUTES=15
DAILY_SUPERVISED_PRODUCTION_RITUAL_INTERVAL_HOURS=24
QUEUE_WORKER_COUNT=1
WORKER_CONCURRENCY=2
MAX_TASKS_PER_CHILD=100
PREFETCH_MULTIPLIER=1
OPERATIONS_CONCURRENCY=1
OPERATIONS_WORKER_READY_TIMEOUT_SECONDS=45
OPERATIONS_WORKER_READY_POLL_INTERVAL_SECONDS=1
REQUIRE_OPERATIONS_WORKER_READY=1
LMCP_TLS_CERT_DIR=/app/runtime/certs
