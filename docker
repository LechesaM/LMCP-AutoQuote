from datetime import datetime

from fastapi import APIRouter

router = APIRouter(
    prefix="/dashboard",
    tags=["Autonomous Control Panel"],
)


@router.get("/status")
def system_status():
    return {
        "system": "LMCP Autonomous Tender Engine",
        "status": "RUNNING",
        "timestamp": datetime.now().isoformat(),
        "services": {
            "database": "connected",
            "redis": "active",
            "celery_workers": "online",
            "harvest_scheduler": "running",
            "autonomous_brain": "active",
        },
    }


@router.get("/statistics")
def statistics():
    return {
        "harvest_frequency_minutes": 30,
        "scoring_frequency_minutes": 15,
        "quote_generation_frequency_minutes": 20,
        "submission_pack_frequency_minutes": 25,
        "email_submission_frequency_minutes": 30,
    }


@router.post("/harvest-now")
def manual_harvest():
    from app.tasks import run_harvest_cycle

    task = run_harvest_cycle.delay()
    return {
        "message": "Tender harvest triggered manually",
        "task_id": task.id,
        "task_name": "run_harvest_cycle",
    }


