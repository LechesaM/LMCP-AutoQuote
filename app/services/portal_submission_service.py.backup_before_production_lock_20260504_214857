    payload = deepcopy(payload if isinstance(payload, dict) else {})

    buyer_rfq_number = _buyer_rfq_number(payload)
    quote_number = _quote_number(payload)

    proof_record = {
        "status": "ok",
        "submission_status": "portal_submission_proof_recorded",
