def _record_dead_letter(candidate: Dict[str, Any], result: Dict[str, Any], reason: str = "") -> None:
    if bool(candidate.get("suppress_dead_letter")):
        return
    url = _safe_str(candidate.get("url") or result.get("url"))
    if not url:
        return
    payload = _read_json_file(DEAD_LETTER_FILE, {"version": "rfq_acquisition_dead_letter_v1", "updated_at": _now_iso(), "items": []})
    if not isinstance(payload, dict):
        payload = {"version": "rfq_acquisition_dead_letter_v1", "updated_at": _now_iso(), "items": []}
    items = payload.get("items") if isinstance(payload.get("items"), list) else []
    items.append(
        {
            "at": _now_iso(),
            "url": url,
            "source": _source_key(url),
            "reason": reason or _safe_str(result.get("error") or result.get("status") or "download_failed"),
            "status": result.get("status"),
            "status_code": result.get("status_code"),
            "retry_count": int(result.get("retry_count") or 0),
            "source_page": candidate.get("source_page"),
            "link_text": candidate.get("link_text"),
        }
    )
    payload["version"] = "rfq_acquisition_dead_letter_v1"
    payload["updated_at"] = _now_iso()
    payload["items"] = items[-5000:]
    _write_json_file(DEAD_LETTER_FILE, payload)


