def _update_replay_metrics(
    replayed: int,
    recovered: int,
    repeated_404_skipped: int,
    preflight_results: List[Dict[str, Any]],
) -> Dict[str, Any]:
    metrics = _read_json_file(METRICS_FILE, {})
    if not isinstance(metrics, dict):
        metrics = {}
    metrics["dead_letters_replayed"] = int(metrics.get("dead_letters_replayed") or 0) + int(replayed or 0)
    metrics["dead_letters_recovered"] = int(metrics.get("dead_letters_recovered") or 0) + int(recovered or 0)
    metrics["repeated_404_skipped"] = int(metrics.get("repeated_404_skipped") or 0) + int(repeated_404_skipped or 0)
    existing_total = int(metrics.get("etenders_preflight_total") or 0)
    existing_success = int(metrics.get("etenders_preflight_success") or 0)
    existing_time = float(metrics.get("preflight_time_total_seconds") or 0.0)
    existing_lookups = int(metrics.get("token_cache_lookups") or 0)
    existing_hits = int(metrics.get("token_cache_hits") or 0)
    added_total = len(preflight_results)
    added_success = sum(1 for row in preflight_results if isinstance(row, dict) and row.get("ok"))
    added_time = sum(float(row.get("preflight_time_seconds") or 0.0) for row in preflight_results if isinstance(row, dict))
    added_hits = sum(1 for row in preflight_results if isinstance(row, dict) and row.get("cache_hit"))
    total = existing_total + added_total
    hits = existing_hits + added_hits
    lookups = existing_lookups + added_total
    metrics["etenders_preflight_total"] = total
    metrics["etenders_preflight_success"] = existing_success + added_success
    metrics["preflight_success_rate"] = round(((existing_success + added_success) / max(total, 1)) * 100.0, 2)
    metrics["preflight_time_total_seconds"] = round(existing_time + added_time, 4)
    metrics["average_preflight_time"] = round((existing_time + added_time) / max(total, 1), 4)
    metrics["token_cache_lookups"] = lookups
    metrics["token_cache_hits"] = hits
    metrics["token_cache_hit_rate"] = round((hits / max(lookups, 1)) * 100.0, 2)
    dead_letter = _dead_letter_summary()
    metrics["dead_letter_count"] = int(dead_letter.get("dead_letter_count") or 0)
    metrics["document_failure_analytics"] = dead_letter
    metrics["updated_at"] = _now_iso()
    _write_json_file(METRICS_FILE, metrics)
    return metrics


def _adaptive_retry_profile(source: str, base_backoff: float, default_retries: int) -> Dict[str, Any]:
    row = _load_source_health().get(source)
    if not isinstance(row, dict):
        return {"backoff_seconds": base_backoff, "max_retries": default_retries, "reason": "default"}
    failure_rate = float(row.get("failure_rate") or 0.0)
    avg_time = float(row.get("average_download_time") or 0.0)
    if failure_rate >= 0.75:
        return {"backoff_seconds": max(base_backoff, 1.5), "max_retries": 1, "reason": "high_failure_fast_isolation"}
    if avg_time >= 8.0:
        return {"backoff_seconds": max(base_backoff, 1.25), "max_retries": max(1, min(default_retries, 1)), "reason": "slow_source_timeout_isolation"}
    if failure_rate <= 0.15 and avg_time <= 2.0:
        return {"backoff_seconds": min(base_backoff, 0.25), "max_retries": default_retries, "reason": "reliable_source_fast_retry"}
    return {"backoff_seconds": base_backoff, "max_retries": default_retries, "reason": "balanced"}


def _update_acquisition_metrics(result: Dict[str, Any], elapsed: float, max_concurrent_downloads: int) -> Dict[str, Any]:
    metrics = _read_json_file(METRICS_FILE, {})
    if not isinstance(metrics, dict):
        metrics = {}
    runs = int(metrics.get("runs") or 0) + 1
    attempts = int(result.get("download_attempt_count") or 0)
    successes = int(result.get("downloaded_count") or 0)
    retries = sum(int(row.get("retry_count") or 0) for row in result.get("downloaded_files", []) if isinstance(row, dict))
    previous_attempts = int(metrics.get("total_attempts") or 0)
    previous_successes = int(metrics.get("total_successes") or 0)
    previous_retries = int(metrics.get("total_retries") or 0)
    total_attempts = previous_attempts + attempts
    total_successes = previous_successes + successes
    total_retries = previous_retries + retries
    total_elapsed = float(metrics.get("total_elapsed_seconds") or 0.0) + float(elapsed or 0.0)
    direct_fast_path_total = int(metrics.get("direct_link_fast_path_total") or 0) + int(result.get("fast_path_direct_link_count") or 0)
    cache_hit_total = int(metrics.get("cache_hit_total") or 0) + int(result.get("cache_hit_count") or 0)
    duplicate_candidate_total = int(metrics.get("duplicate_candidate_total") or 0) + int(result.get("candidate_duplicate_count") or 0)
    previous_avg = float(metrics.get("average_document_download_time") or 0.0)
    avg_time = ((previous_avg * (runs - 1)) + float(elapsed or 0.0)) / max(runs, 1)
    source_health = _load_source_health()
    sources = [
        {"source": key, **value}
        for key, value in source_health.items()
        if isinstance(value, dict)
    ]
    slowest = sorted(sources, key=lambda row: float(row.get("average_download_time") or 0.0), reverse=True)[:5]
