# ================================
# 🌍 ENVIRONMENT
# ================================
ENV=production
LOG_LEVEL=INFO

# ================================
# 🗄️ DATABASE (POSTGRES)
# ================================
POSTGRES_USER=autoquote
POSTGRES_PASSWORD=autoquote
POSTGRES_DB=lmcp_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

DATABASE_URL=postgresql://autoquote:YOUR_POSTGRES_PASSWORD@db:5432/lmcp_db

# ================================
# ⚡ REDIS / CELERY
# ================================
REDIS_URL=redis://redis:6379/0

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ================================
# 📡 ETENDERS (OCDS API)
# ================================
ETENDERS_OCDS_BASE_URL=https://ocds-api.etenders.gov.za
ETENDERS_OCDS_RELEASES_ENDPOINT=/api/OCDSReleases
ETENDERS_TIMEOUT=30
ETENDERS_RETRIES=3

# ================================
# 📧 SMTP EMAIL CONFIG (CRITICAL)
# ================================
SMTP_ENABLED=true

# 🔐 iCloud SMTP (recommended for you)
SMTP_HOST=smtp.mail.me.com
SMTP_PORT=587
SMTP_USERNAME=lechesam@icloud.com
SMTP_PASSWORD=ijht-tdei-etqf-ghqw
SMTP_FROM=lechesam@icloud.com
SMTP_FROM_EMAIL=lechesam@icloud.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_EMAIL=lechesam@icloud.com
SMTP_FROM_NAME=Lechesa Manaba Consulting and Projects (Pty) Ltd

# ================================
# 🔒 EMAIL SECURITY
# ================================
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# ================================
# 📥 IMAP (OPTIONAL – SUPPLIER INGESTION)
# ================================
IMAP_ENABLED=false
IMAP_HOST=imap.mail.me.com
IMAP_PORT=993
IMAP_USERNAME=lechesam@icloud.com
IMAP_PASSWORD=ijht-tdei-etqf-ghqw

# ================================
# 🧾 QUOTE SETTINGS
# ================================
DEFAULT_MARGIN_PERCENT=25
MINIMUM_PROFIT_THRESHOLD=30000

# ================================
# 🚫 EXCLUSIONS
# ================================
BLOCK_MEDICAL_CONSUMABLES=true
BLOCK_IT_EQUIPMENT=true
BLOCK_FUEL=true
BLOCK_CATERING=true

# ================================
# ⚙️ SYSTEM CONTROL
# ================================
PIPELINE_TEST_MODE=false
FORCE_QUOTE_READY=false

# ================================
# 📦 STORAGE
# ================================
QUOTE_STORAGE_PATH=monthly_quotes
LIVE_RFQ_STORE_PATH=runtime/live_rfqs.json

# ================================
# 🧠 AUTONOMOUS ENGINE
# ================================
TENDER_RADAR_MAX_TOTAL=25
TENDER_RADAR_MAX_PER_SOURCE=5

LMCP_REGISTRY_ONLY_MODE=1
LMCP_LEGACY_FALLBACK_ENABLED=0
LMCP_HARVEST_SOURCES_FILE=/app/app/data/harvest_sources.json

AUTO_SUBMIT_ENABLED=true

PORTAL_AUTOMATION_ENABLED=true
PORTAL_HEADLESS=true
PORTAL_TIMEOUT_MS=45000
PORTAL_SLOW_MO_MS=0

PORTAL_USERNAME=lechesam@me.com
PORTAL_PASSWORD=Shakes0516252608@#
PORTAL_USERNAME_SELECTOR=input[name="username"]
PORTAL_PASSWORD_SELECTOR=input[name="password"]
PORTAL_LOGIN_BUTTON_SELECTOR=button[type="submit"]
PORTAL_FILE_INPUT_SELECTOR=input[type="file"]
PORTAL_SUBMIT_BUTTON_SELECTOR=button[type="submit"]
PORTAL_CONFIRMATION_SELECTOR=.confirmation-message

ETENDERS_SESSION_REUSE_ENABLED=true
ETENDERS_SEEDED_LOGIN_MODE=true
ETENDERS_REQUIRE_FRESH_LOGIN=false
ETENDERS_PROFILE_DIR=runtime/playwright/etenders_profile
ETENDERS_STORAGE_STATE_PATH=runtime/playwright/etenders_storage_state.json
ETENDERS_LOGIN_URL=https://www.etenders.gov.za/login/Login
ETENDERS_OPPORTUNITIES_URL=https://www.etenders.gov.za/Home/opportunities?id=1
ETENDERS_CAPTCHA_TEXT=
ETENDERS_FORCE_UPLOAD_ATTEMPT=false

# LMCP SMTP configuration
LMCP_AUTO_SEND_SUBMISSION_EMAIL=false
LMCP_SMTP_HOST=smtp.mail.me.com
LMCP_SMTP_PORT=587
